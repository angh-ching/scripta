# Live OCR/translation needs one provider key. OpenRouter is selected
# automatically when OPENROUTER_API_KEY is present. Set AI_PROVIDER explicitly
# if both keys exist and you want Gemini.
# AI_PROVIDER=openrouter

# OpenRouter (recommended). Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Free vision model with JSON-schema output. Free tier is capped (50 requests
# per day below $10 lifetime credits); switch to a paid model for production.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Gemini fallback. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

PORT=8787
# Use 1 to run the UI without calling a model (canned stream).
MOCK_GEMINI=0
MAX_UPLOAD_MB=12
RATE_LIMIT_PER_MIN=30
LOG_LEVEL=info
