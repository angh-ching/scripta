# Required for live OCR/translation. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Gemini alias is kept current automatically.
# GEMINI_MODEL=gemini-flash-latest

PORT=8787
# Use 1 to run the UI without calling Gemini (canned stream).
MOCK_GEMINI=0
MAX_UPLOAD_MB=12
RATE_LIMIT_PER_MIN=30
LOG_LEVEL=info
